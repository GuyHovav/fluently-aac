# Copy this file to .env (or .env.local) and fill in real values.
# Vite only exposes env vars prefixed VITE_ to client code — see web/src/services/geminiService.ts
# and web/src/services/googleImageService.ts for where these are read.
# Real values live in E:\dev\MyAAC\local.properties (gitignored) for the native app; port them
# here for the web app. Never commit real keys.

VITE_GEMINI_API_KEY=
VITE_GOOGLE_SEARCH_API_KEY=
VITE_GOOGLE_SEARCH_ENGINE_ID=

# Firebase Web SDK config (web/src/services/firebaseConfig.ts), used for the Firestore + Storage
# cloud board backup/restore (web/src/services/cloudBackupService.ts). This is the same Firebase
# project the native app registers via google-services.json for applicationId
# com.example.myaac.hybrid -- get these values from Firebase console > Project settings > General
# > Your apps > Web app (add one if none exists yet; it can point at the same project as the
# Android app). Auth itself does NOT need these vars -- Google Sign-In goes through
# @capacitor-firebase/authentication's native plugin, configured separately in Phase 0.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
